# Modelfile Ollama — générateur AItertainment (après fine-tune + GGUF)
#
#   ollama create aitertainment-generator -f deploy/Modelfile.generator
#
# Remplacer le chemin FROM par ton fichier .gguf quantizé (Q4_K_M recommandé).

FROM ../models/aitertainment-generator-q4km.gguf

PARAMETER temperature 0.6
PARAMETER top_p 0.85
PARAMETER num_predict 24
PARAMETER repeat_penalty 1.2
PARAMETER stop "### Instruction:"
PARAMETER stop "### Input:"
PARAMETER stop "\n\n"

# Template Alpaca — identique à finetune_generator.ipynb et modules/generator_prompt.py
TEMPLATE """### Instruction:
{{ .System }}

### Input:
{{ .Prompt }}

### Response:
"""

SYSTEM """Tu es un utilisateur Instagram. Écris UN commentaire en français. Pas d'emoji. Pas de @mention. Respecte la longueur cible dans l'Input : court (3 à 10 mots) ou développé (11 à 40 mots, 1 à 2 phrases max). Reste ancré sur la Caption et le contexte vidéo — pas de digression."""
