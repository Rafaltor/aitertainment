# ─────────────────────────────────────────────────────────────────────────────
# AItertainment — variables d'environnement
#
# Copier ce fichier en `.env` à la racine du projet :
#     cp .env.example .env
# puis remplir les valeurs. Le fichier `.env` est chargé automatiquement par
# `config.py` via `python-dotenv` au démarrage de chaque module.
#
# Toutes les valeurs sont des **strings** : les conversions (float / int / bool)
# sont faites côté config.py.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Telegram Bot #1 — Watcher (alertes virales temps réel) ──────────────────
# Crée un bot via @BotFather → récupère le token, et envoie /start au bot
# depuis le compte ciblé pour récupérer ton chat_id (cf. README_SETUP).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─── Telegram Bot #2 — Discovery (validation humaine des candidats) ──────────
# Bot SÉPARÉ pour ne pas mélanger les alertes virales (Watcher, fréquentes)
# avec les revues humaines de candidats (Discovery, asynchrones).
# Si vide, on retombe automatiquement sur TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# (utile pour tester sans créer un second bot).
TELEGRAM_DISCOVERY_TOKEN=
TELEGRAM_DISCOVERY_CHAT_ID=


# ─── Instagram (Playwright) ────────────────────────────────────────────────────
# Session navigateur : exporter les cookies du compte dédié vers
# `data/instagram_cookies.json` (format Playwright : liste de cookies ou
# `{"cookies": [...]}`). Voir README_SETUP §6. JAMAIS le compte personnel.

# Watcher — anti-flag & cadence de polling (secondes). Redémarrer le process après changement.
# Comptes vérifiés avant pause longue anti-flag (défaut config.py : 50).
MAX_ACCOUNTS_PER_SESSION=50
# Durée de la pause longue (défaut : 600 = 10 min).
WATCHER_ACCOUNTS_PAUSE_S=600
# Délai entre deux créateurs dans un cycle (défaut : 3).
WATCHER_SLEEP_BETWEEN_CREATORS_S=3
# Intervalle entre cycles : prime 17h–21h / jour 09h–17h / nuit (défauts : 300 / 600 / 1800).
WATCHER_PRIME_INTERVAL_S=300
WATCHER_DAY_INTERVAL_S=600
WATCHER_NIGHT_INTERVAL_S=1800


# ─── Discovery (Layer 0 — détection automatique de candidats) ────────────────
# Quota humain de profils scorés par jour (seed + followings comptent dans ce quota).
# Défaut dans config.py = 40 si cette ligne est absente. Mettre 5 pour limiter en test.
MAX_PROFILES_PER_DAY=40

# Pause aléatoire entre deux médias dans le scrape de commentaires (secondes).
DISCOVERY_BETWEEN_POSTS_MIN_S=20
DISCOVERY_BETWEEN_POSTS_MAX_S=45

# Pause aléatoire entre deux profils dans `explore_network` (secondes).
DISCOVERY_BETWEEN_PROFILES_MIN_S=90
DISCOVERY_BETWEEN_PROFILES_MAX_S=180
# false = pas de scrape commentaires sur les profils découverts (corpus = fil Reels / viral_comments.json)
DISCOVERY_COLLECT_COMMENTS=false

# Bypass des fenêtres horaires humaines (nuit 23h-8h, déjeuner 12h-14h, burst
# pause toutes les 2h). À mettre à `false` en prod pour respecter ces fenêtres,
# `true` en mode test pour pouvoir tourner à toute heure.
# Valeurs acceptées : true / false / 1 / 0 / yes / no / on / off.
DISABLE_HUMAN_SCHEDULE=true


# ─── LM Studio (embeddings profils — scripts/embedder.py) ───────────────────
# Serveur local LM Studio avec un modèle d'embedding chargé (API OpenAI-compatible).
# Le nom du modèle doit correspondre à l'identifiant affiché dans LM Studio.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_EMBED_MODEL=


# ─── Ollama (LLM local pour classifier T-types et generate_comments) ─────────
# Endpoint /api/generate ; sur Mac Mini avec Ollama installé localement le
# défaut suffit. Pour pointer un Ollama distant : http://<host>:11434/api/generate
# Le legacy alias `OLLAMA_GENERATE_URL` reste accepté en repli côté config.
OLLAMA_URL=http://localhost:11434/api/generate

# Modèle Ollama à charger. `qwen2.5:7b` est le défaut (≈4 Go RAM, rapide sur M4).
# Alternatives : `llama3.1:8b`, `mistral:7b`, `qwen2.5:14b` (plus lent).
OLLAMA_MODEL=qwen2.5:7b

# Générateur fine-tuné (format Alpaca). Laisser vide = ancien prompt JSON via OLLAMA_MODEL.
# Après `ollama create aitertainment-generator -f deploy/Modelfile.generator` :
OLLAMA_GENERATOR_MODEL=aitertainment-generator


# ─── Apify (legacy — n'est plus utilisé) ─────────────────────────────────────
# Conservé pour compat avec d'éventuels anciens scripts du dossier `modules/`.
# Peut rester vide en prod ; aucune dépendance critique.
APIFY_TOKEN=
ANTHROPIC_API_KEY=